# Exclude from Docker build context (speeds up docker build)
.git
.github
.hypothesis
.pytest_cache
.mypy_cache
__pycache__
*.pyc
*.pyo

# Test files (not needed in production image)
tests/

# Development files
.env
.env.*
*.egg-info
*.egg
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Node modules (frontend has its own stage)
web/node_modules/
web/dist/
web/.vite/

# Large data files (mount as volume instead)
data/raw/

# Logs (mount as volume)
logs/
